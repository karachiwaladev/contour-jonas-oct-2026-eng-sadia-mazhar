{
  "version": 1,
  "hooks": {
    "beforeSubmitPrompt": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/append-prompt.ps1"
      }
    ],
    "afterFileEdit": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/scenario-after-file-edit.ps1",
        "matcher": "Write",
        "timeout": 5
      }
    ],
    "postToolUse": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/scenario-post-tool-use.ps1",
        "matcher": "Write",
        "timeout": 5
      },
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/security-check-changed-file.ps1",
        "matcher": "Write",
        "timeout": 5
      },
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/factory-loop-ticket-scan.ps1",
        "matcher": "Shell",
        "timeout": 15
      }
    ],
    "beforeShellExecution": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/security-before-shell.ps1",
        "matcher": "deepsec|DeepSec|nmap|Nmap|nikto|Nikto|sqlmap|Sqlmap|nuclei|Nuclei|masscan|Masscan|msfconsole|Msfconsole",
        "timeout": 5,
        "failClosed": true
      },
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/factory-loop-untrusted-input.ps1",
        "matcher": "gh\\s+(pr\\s+(checkout|merge)|issue\\s+(view|list)|api.*?issues)|git\\s+(merge|fetch|pull|checkout|switch).*?(refs/pull|pull/|fork)",
        "timeout": 5,
        "failClosed": true
      },
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/factory-loop-before-push.ps1",
        "matcher": "git\\s+push",
        "timeout": 15,
        "failClosed": true
      }
    ],
    "stop": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/security-on-stop.ps1",
        "timeout": 10,
        "loop_limit": 1
      },
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/scenario-on-stop.ps1",
        "timeout": 10,
        "loop_limit": 1
      },
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/flush-prompts-on-stop.ps1"
      },
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/factory-loop-commit-push-on-stop.ps1"
      }
    ],
    "sessionEnd": [
      {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -File .cursor/hooks/flush-prompts-on-stop.ps1"
      }
    ]
  }
}
